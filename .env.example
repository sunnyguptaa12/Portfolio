# Copy to .env and fill in. Only VITE_-prefixed values are exposed to the browser (never put secrets here).
VITE_GITHUB_URL=https://github.com/your-username
VITE_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
VITE_LEETCODE_URL=https://leetcode.com/u/your-username
VITE_CONTACT_EMAIL=your.email@example.com
VITE_RESUME_URL=/resume.pdf
